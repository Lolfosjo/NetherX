{
    "name": "lolfosjo/netherx",
    "description": "Plugin for PocketMine-MP that adds the vanilla Minecraft 1.16 Nether.",
    "type": "project",
    "require": {
        "bstats/pocketmine-mp": "^1.0.0"
    },
    "require-dev": {
        "php": "^8.1",
        "phpstan/phpstan": "2.2.16",
        "sof3/pharynx": "^0.3.8"
    },
    "autoload": {
        "psr-0": {
            "lolfosjo\\netherx\\": "src"
        }
    },
    "scripts": {
        "build": "php -dphar.readonly=0 vendor/bin/pharynx -i=. -c -p=NetherX.phar"
    }
}
